# Copy to .env to override defaults. `npm run dev` loads ./.env automatically if present.

# Comma-separated broker list (docker-compose exposes Kafka on localhost:9092)
KAFKA_BROKERS=localhost:9092
LOG_LEVEL=info

# order-service HTTP port
ORDER_SERVICE_PORT=3000

# --- payment-service chaos toggles (0.0 - 1.0) ---
# Probability that processing a payment throws a *transient* error.
# Transient errors are retried with exponential backoff; if every attempt fails
# the message is published to orders.created.dlq.
PAYMENT_FAILURE_RATE=0
# Probability that a payment is *declined* (business outcome -> payments.failed).
PAYMENT_DECLINE_RATE=0

# Consumer retry policy (shared by all consumers)
CONSUMER_MAX_RETRIES=3
CONSUMER_INITIAL_RETRY_MS=200
CONSUMER_MAX_RETRY_MS=5000

# Copy to .env to override defaults. `npm run dev` loads ./.env automatically if present.
# Every value below is optional - the defaults match docker-compose.yml.

# --- Kafka -------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
LOG_LEVEL=info

# order-service HTTP port
ORDER_SERVICE_PORT=3000

# --- OAuth2 / OIDC (Keycloak from docker-compose) ------------------------------
AUTH_ISSUER=http://localhost:8081/realms/orderflow
AUTH_AUDIENCE=order-service
# Derived from AUTH_ISSUER unless set:
# AUTH_JWKS_URI=http://localhost:8081/realms/orderflow/protocol/openid-connect/certs
# AUTH_TOKEN_URL=http://localhost:8081/realms/orderflow/protocol/openid-connect/token

# Client credentials for the tools. These are the DEMO secrets from
# infra/keycloak/realm-export.json - never reuse them outside local development.
LOADGEN_CLIENT_ID=load-generator
LOADGEN_CLIENT_SECRET=load-generator-demo-secret
DLQ_REPLAY_CLIENT_ID=dlq-replay
DLQ_REPLAY_CLIENT_SECRET=dlq-replay-demo-secret

# --- Feature flags (see docs/ld-flags.md) ------------------------------------
# Set a LaunchDarkly *server-side* SDK key to use LaunchDarkly. Leave empty to use
# local flags from feature-flags.json (edit it while services run to change flags).
LD_SDK_KEY=
# FEATURE_FLAGS_FILE=./feature-flags.json

# Local-provider overrides (win over feature-flags.json; ignored when LD_SDK_KEY is set):
# FLAG_PAYMENT_FAILURE_RATE=0        # chaos: 0.0 - 1.0, replaces the old PAYMENT_FAILURE_RATE
# FLAG_PAYMENT_CONSUMER_ENABLED=true # false pauses the payment consumer
# FLAG_FRAUD_CHECK_ENABLED=false
# FLAG_NOTIFICATION_CHANNEL=email    # email | sms | push | slack
# FLAG_MAX_RETRY_ATTEMPTS=3          # 0 - 10

# --- payment-service business rules --------------------------------------------
# Probability that a card is randomly declined (business outcome -> payments.failed).
PAYMENT_DECLINE_RATE=0
PAYMENT_CARD_LIMIT=2000

# --- Consumer retry backoff (the retry *count* is the max-retry-attempts flag) --
CONSUMER_INITIAL_RETRY_MS=200
CONSUMER_MAX_RETRY_MS=5000
